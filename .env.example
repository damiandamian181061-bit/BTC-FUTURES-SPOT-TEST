# Copy to .env (git ignores .env) and fill in only what you need: every line is optional.
#   cp .env.example .env
# Read by the Python code (backend/src/btc_bot/config.py) and by docker compose. A real environment variable
# always wins over a line here. Never commit real keys.

# --- Binance Demo API keys --------------------------------------------------------------------------------------
# Leave these empty to keep reading them from the secrets file (BTC_BOT_SECRETS below).
# Any value set here overrides the same key from that file.
B_SPOT_API_KEY=
B_SPOT_API_SECRET=
A_FUTURES_API_KEY=
A_FUTURES_API_SECRET=

# Telegram messages (btc-bot notify): TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID also go in the secrets file, never
# here. `btc-bot notify setup` writes them there for you.

# Secrets file the Python code reads when running on the host (default: ~/.config/btc-bot/secrets.env)
# BTC_BOT_SECRETS=~/.config/btc-bot/secrets.env

# Docker only: host path of that secrets file, mounted read-only into the container at /run/secrets/btc-bot.env.
# Run docker compose from WSL so this Linux path resolves. Leave unset if the keys are in this file instead.
# HOST_SECRETS_FILE=/home/<you>/.config/btc-bot/secrets.env

# --- Paths (relative to the project root) --------------------------------------------------------------------
# BTC_BOT_DATA_DIR=data
# BTC_BOT_PAPER_DIR=data/paper
# BTC_BOT_CHARTS_DIR=charts

# --- Web app / API -------------------------------------------------------------------------------------------
# Port on 127.0.0.1 that docker compose publishes the app on
APP_PORT=8000

# --- DigitalOcean dashboard mirror (deploy/digitalocean/README.md) ---------------------------------------------
# Leave DO_HOST unset and nothing is ever copied anywhere. Once set, scripts/run.sh syncs after every scheduled run.
# DO_HOST=203.0.113.10
# Name the HTTPS certificate is for: your domain (A record -> DO_HOST), or by default <ip-with-dashes>.sslip.io
# DO_SITE=203-0-113-10.sslip.io
